---
import { getCollection } from 'astro:content';
import EntryView from '../../../components/EntryView.astro';
import { EDITING_ENABLED } from '../../../lib/permissions.js';
import { drafts } from '../../../lib/entryData.js';

export async function getStaticPaths() {
  // Dev-only, drafts-only: previews an unpublished entry with the same view (and edit/new FAB)
  // as a real post. Returns [] in prod so drafts never get a built page or public URL.
  if (!EDITING_ENABLED) return [];
  const posts = await getCollection('posts');
  return drafts(posts).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
---

<EntryView post={post} />
